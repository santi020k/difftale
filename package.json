{
  "name": "@santi020k/difftale-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "pnpm run lint:repo && turbo run lint",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo": "eslint . --no-warn-ignored",
    "lint:repo:fix": "eslint . --fix --no-warn-ignored",
    "ok": "pnpm install --frozen-lockfile && pnpm run build && pnpm run test && pnpm run lint && pnpm run typecheck",
    "package:extension": "pnpm --filter vscode-difftale package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "packageManager": "pnpm@10.34.3"
}
